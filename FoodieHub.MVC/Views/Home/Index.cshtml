@using FoodieHub.MVC.Models.Recipe
@using FoodieHub.MVC.Service.Interfaces
@using FoodieHub.MVC.Models.QueryModel
@inject IProductService _productService;
@inject IOrderService _orderService;
@inject IReviewService _reviewService;
@inject IConfiguration Configuration
@inject IFavoriteService favoriteService;
@inject IRecipeCategoryService recipeCategory;
@inject IUserService userService;
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var apiUrl = Configuration["BaseHost"];

    var listFavorites = await favoriteService.GetFR() ?? new List<GetRecipeDTO>();

    var mostFavoriteRecipe = Model
    .Where(x => x.IsActive)
    .OrderByDescending(x => x.TotalFavorites)
    .FirstOrDefault();

    var ourLatestRecipes = Model
        .Where(x => x.RecipeID != mostFavoriteRecipe?.RecipeID)
        .Take(8)
        .ToList();

    var listCategoriesRecipes = await recipeCategory.GetAll();

    var queryUser = new QueryUserModel{
        PageSize = 20
    };
    var getUsers = await userService.Get(queryUser);

	var getUsersActive = getUsers?.Items
		.Where(x => x.IsActive)
		.ToList();
}
<!-- Swiper CSS -->
<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css" />
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true">

@model IEnumerable<GetRecipeDTO>
<div class="container">
    @* mostFavoriteRecipe *@
    <div class="row mostFavoriteRecipe">
        @if (mostFavoriteRecipe != null)
        {
            <div class="col-md-6 d-flex justify-content-center align-items-center">
                <a href="@Url.Action("Detail", "Recipes", new { id = mostFavoriteRecipe.RecipeID })">
                    <img src="@mostFavoriteRecipe.ImageURL" alt="@mostFavoriteRecipe.Title" class="img-fluid rounded" style="width: 100%; max-height:600px" />
                </a>
            </div>
            <div class="col-md-6 d-flex justify-content-center align-items-center  px-15 py-30">
                <div class="info-mostFavoriteRecipe text-center">
                    <span class="text-uppercase text-muted small">Recipe of the Day</span>
                    <a href="@Url.Action("Detail", "Recipes", new { id = mostFavoriteRecipe.RecipeID })">
                        <h2 id="font-aime" class="title-mostFavoriteRecipe fw-bold">@mostFavoriteRecipe.Title</h2>
                    </a>
                    <div class="author d-flex align-items-center justify-content-center mt-2">
                        <img alt="avatar" src="@mostFavoriteRecipe.Avatar" />
                        <span class="ms-2">@mostFavoriteRecipe.FullName</span>
                    </div>
                    <div class="favorite mt-2">
                        <a href="javascript:void(0);"
                           class="text-decoration-none favoriteBtn"
                           data-recipe-id="@mostFavoriteRecipe.RecipeID"
                           data-favorited="@listFavorites.Select(x => x.RecipeID).Contains(mostFavoriteRecipe.RecipeID).ToString().ToLower()">

                            <i id="favoriteIcon" class="@(listFavorites.Select(x => x.RecipeID).Contains(mostFavoriteRecipe.RecipeID) ? "fas" : "far") fa-heart"></i>
                            <span id="favoriteCount" class="ms-1">@mostFavoriteRecipe.TotalFavorites</span>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="home-content">
        <div class="mt-3">
            @* các recipe mới *@
            <div class="mt-2">
                <div class="d-flex justify-content-between">
                    <div>
                        <h3 id="font-aime" style="font-size: 25px;">Our Latest Recipes</h3>
                    </div>
                    <div class="containerbtn">
                        <a class="btnSeeMore" asp-action="Index" asp-controller="Recipes">See More</a>
                    </div>
                </div>
                <div class="row">
                    @if (Model.Any())
                    {
                        @foreach (var recipe in ourLatestRecipes)
                        {
                            <div class="mt-3 col-6 col-sm-6 col-lg-3 col-md-4" style="padding:5px;">
                                <div class="card-more-delicious-item">
                                    <div class="card-more-delicious-item-content">
                                        <a href="@Url.Action("Detail", "Recipes", new { id = recipe.RecipeID })">
                                            <img class="img-fluid" alt="@recipe.Title" src="@recipe.ImageURL" />
                                            <div class="badges">
                                                <span class="badge time">
                                                    <i class="far fa-clock"></i> @recipe.CookTime.ToString("HH:mm") min
                                                </span>
                                                <span class="badge catename">
                                                    @recipe.CategoryName
                                                </span>
                                            </div>
                                        </a>
                                        <div class="favorite">
                                            <a href="javascript:void(0);"
                                               class="text-decoration-none favoriteBtn"
                                               data-recipe-id="@recipe.RecipeID"
                                               data-favorited="@listFavorites.Select(x => x.RecipeID).Contains(recipe.RecipeID).ToString().ToLower()">

                                                <i id="favoriteIcon" class="@(listFavorites.Select(x => x.RecipeID).Contains(recipe.RecipeID) ? "fas" : "far") fa-heart"></i>
                                                <span id="favoriteCount" class="ms-1">@recipe.TotalFavorites</span>
                                            </a>
                                        </div>
                                    </div>
                                    <h3>@recipe.Title</h3>
                                    <div class="card-more-delicious-item-footer">
                                        <div class="author">
                                            <img alt="avatar" src="@recipe.Avatar" class="rounded-circle" style="object-fit: cover;" />
                                            <span>@recipe.FullName</span>
                                        </div>
                                        <div class="rating">
                                            <span>@recipe.RatingAverage</span>
                                            <i class="fas fa-star ms-1"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p>No recipes found.</p>
                    }
                </div>
            </div>
            @* cate *@
            <div class="mt-3">
                <h3 id="font-aime" style="font-size: 25px;">What to cook today</h3>
                <div class="row">
                    @if (listCategoriesRecipes != null)
                    {
                        foreach (var category in listCategoriesRecipes)
                        {
                            <div class="col-6 col-sm-4 col-md-4 col-lg-4 text-center mb-3 categoriesRecipes">
                                <a href="@Url.Action("Index", "Recipes", new { categoryId = category.CategoryID })" class="text-decoration-none">
                                    <div class="p-2 bg-light info-cate">
                                        <img src="@category.ImageURL" alt="@category.CategoryName" class="img-fluid mb-2" style="height: 60px;" />
                                        <div class="fw-bold text-dark">@category.CategoryName</div>
                                    </div>
                                </a>
                            </div>
                        }
                    }
                    else
                    {
                        <p>No recipes Category found.</p>
                    }
                </div>
            </div>
            @* Explore the best recipes from *@
            <div class="mt-3">
                <h3 id="font-aime" style="font-size: 25px;">Explore the best recipes from</h3>
                <div class="swiper">
                    <div class="card-swiper" style="margin: 20px;">
                        <ul class="swiper-wrapper" style="padding-left: 0px;">
                            @if (getUsersActive != null)
                            {
                                foreach (var user in getUsersActive)
                                {
                                    <li class="text-center border-0 p-3 swiper-slide">
                                        <a href=@("/account/userinfo/"+user.Id)>
                                            <img src="@(!string.IsNullOrEmpty(user.Avatar) ? user.Avatar : "/images/profile.jpg")"
                                                 alt="@user.Fullname"
                                                 class="rounded-circle mx-auto d-block"
                                                 style="width: 70px; height: 70px; object-fit: cover;" />
                                            <div class="mt-2 fw-semibold text-dark">@user.Fullname</div>
                                        </a>
                                    </li>
                                }
                            }
                        </ul>
                        <div class="swiper-pagination"></div>
                        <!-- If we need navigation buttons -->
                        <div class="swiper-button-prev"></div>
                        <div class="swiper-button-next"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const favoriteBtns = document.querySelectorAll(".favoriteBtn");

            favoriteBtns.forEach(favoriteBtn => {
                favoriteBtn.addEventListener("click", async function (event) {
                    event.preventDefault();
                    event.stopPropagation(); // Ngăn sự kiện click lan lên thẻ <a> cha nếu có

                    const btn = this;
                    const recipeId = btn.dataset.recipeId;
                    const isFavorited = btn.dataset.favorited === "true";

                    const url = isFavorited
                        ? '@Url.Action("UnFavorite", "Recipes")'
                        : '@Url.Action("Favorite", "Recipes")';

                    try {
                        const response = await fetch(`${url}?id=${recipeId}`, {
                            method: "POST",
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const result = await response.json();

                        if (result.success) {
                            const icon = btn.querySelector("i");
                            const countSpan = btn.querySelector("span");
                            let count = parseInt(countSpan.innerText);

                            if (isFavorited) {
                                icon.classList.remove("fas");
                                icon.classList.add("far");
                                btn.dataset.favorited = "false";
                                countSpan.innerText = count - 1;
                            } else {
                                icon.classList.remove("far");
                                icon.classList.add("fas");
                                btn.dataset.favorited = "true";
                                countSpan.innerText = count + 1;
                            }

                            showNotification(result.message, result.notificationType);
                        } else {
                            showNotification(result.message, result.notificationType);
                        }
                    } catch (err) {
                        console.error("You need to log in to continue.", err);
                        showNotification("You need to log in to continue.", "error");
                    }
                });
            });
        });


        // Thông báo Notyf
        const notyf = new Notyf({
            duration: 4000,
            dismissible: true,
            ripple: true,
            position: { x: 'right', y: 'top' },
            dismissOthers: true
        });

        function showNotification(message, type) {
            if (type === 'success') {
                notyf.success(message);
            } else {
                notyf.error(message);
            }
        }
        const swiper = new Swiper('.card-swiper', {
          // Optional parameters

          // If we need pagination
          pagination: {
            el: '.swiper-pagination',
            clickable: true,
            dynamicBullets: true,
          },

          // Navigation arrows
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },

          breakpoints: {
          320: { slidesPerView: 3 },
          576: { slidesPerView: 4 },
          768: { slidesPerView: 5 },
          992: { slidesPerView: 6 },
          1200: { slidesPerView: 7 }
        }
        });
    </script>
}
